{
  "name": "dsh-web-search-switch",
  "version": "0.2.0",
  "description": "Switch the DeepSeek Harness web_search source (DeepSeek official, Ollama, Tavily, Brave, Exa, Serper, Bocha, Zhipu, SearXNG) and the web_fetch source (local http, Ollama, DeepSeek Fetch API) from a settings page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "scripts"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-alpha.3 <0.4.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.2-alpha.3 <0.4.0",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.8 <0.4.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "web-fetch",
    "search-provider",
    "fetch-provider",
    "ollama",
    "tavily",
    "brave",
    "exa",
    "searxng"
  ],
  "license": "MIT",
  "author": "xiaokang6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaokang6/dsh-web-search-switch.git"
  },
  "homepage": "https://github.com/xiaokang6/dsh-web-search-switch#readme",
  "bugs": {
    "url": "https://github.com/xiaokang6/dsh-web-search-switch/issues"
  }
}
